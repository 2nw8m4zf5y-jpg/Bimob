{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nagaplas.dev",
  "title": "NAGAPLAS AI Copilot & C++20 Core Interop Protocol",
  "description": "Инженерный контракт обмена данными между C++20 BIM/CAD ядром NAGAPLAS, Jetpack Compose UI и LLM/GPT (реализация F097–F103, F109). Дополнения v1.2: инварианты целостности, идемпотентность, единообразие единиц, журнал аудита, бюджеты производительности и политика версионирования нормативных источников.",
  "version": "1.2.0",
  "units_standard": {
    "length": "millimeters (mm)",
    "area": "square_meters (m2)",
    "volume": "cubic_meters (m3)",
    "angle": "degrees (deg, CCW from +X)",
    "coordinate_system": "Right-handed Z-up (X: East/Right, Y: North/Up on plan, Z: Elevation)"
  },
  "precision_and_tolerances": {
    "description": "Строгие геометрические и топологические допуски ядра C++20 для защиты графа от микро-сегментов и разрывов. Допуски — параметры конкретных операций, не универсальное правило автоматического объединения.",
    "snap_tolerance_mm": 1.0,
    "angle_tolerance_deg": 0.05,
    "min_wall_length_mm": 50.0,
    "min_opening_clearance_mm": 50.0,
    "coordinate_rounding_step_mm": 0.1,
    "auto_t_join_solver": "F103",
    "tolerance_policy_v1_2": {
      "principles": [
        "Не применять единый допуск ко всем геометрическим предикатам.",
        "Разделять input snap, topology healing, display rounding, solver convergence и export tolerance.",
        "Округление отображения не изменяет хранимую геометрию.",
        "При неоднозначной tolerance-операции сообщать неоднозначность, не объединять/перемещать молча.",
        "Использовать double и устойчивые предикаты для критичных пересечений/принадлежности."
      ],
      "suggested_defaults_not_certified": {
        "input_snap_mm": 1.0,
        "display_rounding_mm": 0.1,
        "minimum_wall_length_mm": 50.0,
        "angle_snap_deg": 0.05,
        "note": "Настраиваемые проектные значения, не гарантии инженерной точности."
      }
    }
  },
  "safety_and_concurrency_policy": {
    "description": "Защита от гонок данных, разрушающих галлюцинаций и повреждения закреплённой геометрии.",
    "optimistic_concurrency": {
      "required_revision_field": "expected_revision",
      "on_mismatch": "REJECT_AND_REFRESH_CONTEXT"
    },
    "pinned_elements_protection": "STRICT_DENY_IN_CPP_CORE",
    "max_affected_elements_without_elevated_confirm": 15,
    "shadow_sandbox_execution": {
      "enabled": true,
      "mode": "CopyOnWrite_Graph_Branch",
      "auto_run_norm_control": true,
      "wal_transaction_on_commit": "F109"
    },
    "transaction_integrity_v1_2": {
      "idempotency": {
        "required_for_write_commands": true,
        "field": "request_id",
        "duplicate_request_behavior": "RETURN_PREVIOUS_RESULT_WITHOUT_REAPPLY",
        "scope": "project_id + request_id",
        "retention": "Persist with transaction log/checkpoint policy"
      },
      "atomic_commit": "All-or-nothing; failed validation or persistence must not partially mutate canonical model",
      "pre_commit_validation": [
        "schema validation",
        "expected_revision validation",
        "element ID/reference validation",
        "pinned-element policy",
        "geometric/topological invariants",
        "applicable project checks"
      ],
      "post_commit_audit": {
        "record_actor": true,
        "record_command": true,
        "record_affected_ids": true,
        "record_revision_before_after": true,
        "record_validation_summary": true,
        "record_transaction_id": true
      },
      "crash_recovery": {
        "replay_only_valid_committed_records": true,
        "checksum_validation": true,
        "atomic_snapshot_replace": true,
        "keep_previous_valid_snapshot": true
      }
    }
  },
  "system_prompt_template": {
    "role": "system",
    "content": "Ты — встроенный ИИ-архитектор и BIM-инженер мобильного САПР NAGAPLAS (ядро C++20, протокол v1.2). Все линейные размеры передаются и задаются строго в миллиметрах (мм), углы — в градусах. Никогда не выдумывай ID элементов: используй только реальные ID из актуального scene_context (F097) либо временные идентификаторы формата \"$temp_id\" (например, \"$w1\") внутри одного батча вызовов. В каждый write-инструмент обязательно передавай актуальный expected_revision из scene_context. Любые изменения модели выполняй исключительно через зарегистрированные write-инструменты (F098): они выполняются в теневой ветке графа C++20, проходят применимые проверки СП/ГОСТ (F088), отображаются в Ghost Preview (F100) и фиксируются в бинарном журнале WAL (F109) с поддержкой Undo/Redo (F065) только после подтверждения инженера. Не изменяй и не удаляй элементы с is_pinned=true. Нормативные значения не считай универсальными: применяй только проверенные версионированные правила с установленным источником и подтверждённой применимостью. При неоднозначной геометрии не угадывай. Команды записи должны использовать request_id, expected_revision и проверку до/после выполнения; повтор запроса не должен применяться дважды. Не заявляй о проверках, которые не проводились, или показателях производительности, которые не измерялись. Ядро C++20 — единственный источник истины геометрии."
  },
  "scene_context_schema": {
    "description": "Компактный JSON-снимок сцены, формируемый C++20 ядром за <2 мс (F097) с поддержкой уровней детализации (LOD/Culling F077).",
    "type": "object",
    "required": [
      "scene_revision",
      "detail_level",
      "project_meta",
      "active_view",
      "selection",
      "visible_topology",
      "diagnostics"
    ],
    "properties": {
      "scene_revision": {
        "type": "integer",
        "minimum": 1,
        "description": "Монотонно возрастающий номер ревизии графа C++20 (Optimistic Concurrency Control).",
        "example": 148
      },
      "detail_level": {
        "type": "string",
        "enum": [
          "Compact",
          "Viewport",
          "Full"
        ],
        "description": "Уровень детализации контекста: Compact (выделение + сводка), Viewport (видимая область с Frustum Culling), Full (весь этаж)."
      },
      "total_elements_summary": {
        "type": "object",
        "description": "Сводка по всем элементам активного этажа (включая находящиеся за пределами вьюпорта).",
        "properties": {
          "walls_count": {
            "type": "integer",
            "example": 64
          },
          "openings_count": {
            "type": "integer",
            "example": 28
          },
          "rooms_count": {
            "type": "integer",
            "example": 12
          },
          "serialization_time_us": {
            "type": "integer",
            "example": 840
          }
        }
      },
      "project_meta": {
        "type": "object",
        "required": [
          "project_name",
          "active_level",
          "available_wall_types",
          "available_family_types"
        ],
        "properties": {
          "project_name": {
            "type": "string",
            "example": "ЖК_Горный_Секция_1.nagaplas"
          },
          "active_level": {
            "type": "object",
            "required": [
              "id",
              "name",
              "elevation_mm",
              "floor_to_floor_mm"
            ],
            "properties": {
              "id": {
                "type": "string",
                "example": "LVL_01"
              },
              "name": {
                "type": "string",
                "example": "Этаж 01"
              },
              "elevation_mm": {
                "type": "number",
                "example": 0.0
              },
              "floor_to_floor_mm": {
                "type": "number",
                "example": 3300.0
              }
            }
          },
          "available_wall_types": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type_id",
                "name",
                "thickness_mm"
              ],
              "properties": {
                "type_id": {
                  "type": "string",
                  "example": "WT_EXT_380_GAS"
                },
                "name": {
                  "type": "string",
                  "example": "Наружная Газобетон D500 300мм + Утеплитель 80мм"
                },
                "thickness_mm": {
                  "type": "number",
                  "example": 380
                },
                "is_structural": {
                  "type": "boolean",
                  "example": true
                },
                "u_value_w_m2k": {
                  "type": "number",
                  "example": 0.28
                }
              }
            }
          },
          "available_family_types": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "type_id",
                "category",
                "name",
                "width_mm",
                "height_mm"
              ],
              "properties": {
                "type_id": {
                  "type": "string",
                  "example": "DR_INT_800x2100"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "Door",
                    "Window",
                    "Column",
                    "MEP_Fixture",
                    "Furniture"
                  ]
                },
                "name": {
                  "type": "string",
                  "example": "Дверь межкомнатная ДГ 21-9 (800х2100)"
                },
                "width_mm": {
                  "type": "number",
                  "example": 800
                },
                "height_mm": {
                  "type": "number",
                  "example": 2100
                }
              }
            }
          }
        }
      },
      "active_view": {
        "type": "object",
        "required": [
          "view_id",
          "view_type",
          "visual_style"
        ],
        "properties": {
          "view_id": {
            "type": "string",
            "example": "VIEW_PLAN_L1"
          },
          "view_type": {
            "type": "string",
            "enum": [
              "FloorPlan",
              "View3D",
              "Section",
              "Elevation",
              "Sheet"
            ]
          },
          "visual_style": {
            "type": "string",
            "enum": [
              "Wireframe",
              "HiddenLine",
              "Shaded",
              "Realistic"
            ]
          },
          "viewport_bounds_mm": {
            "type": "object",
            "properties": {
              "min_x": {
                "type": "number"
              },
              "min_y": {
                "type": "number"
              },
              "max_x": {
                "type": "number"
              },
              "max_y": {
                "type": "number"
              }
            }
          },
          "touch_cursor_mm": {
            "type": [
              "object",
              "null"
            ],
            "description": "Координаты последнего тапа/удержания пальца на холсте (F101).",
            "properties": {
              "x": {
                "type": "number",
                "example": 4500.0
              },
              "y": {
                "type": "number",
                "example": 3200.0
              },
              "snapped_element_id": {
                "type": [
                  "string",
                  "null"
                ],
                "example": "W_014"
              },
              "snap_type": {
                "type": [
                  "string",
                  "null"
                ],
                "example": "Midpoint"
              }
            }
          }
        }
      },
      "selection": {
        "type": "object",
        "required": [
          "selected_ids"
        ],
        "properties": {
          "selected_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "W_014",
              "RM_03"
            ]
          },
          "set_of_mark_mapping": {
            "type": "object",
            "description": "Соответствие визуальных бейджей на скриншоте (#1, #2) реальным ID графа C++20 (F100).",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "#1": "W_014",
              "#2": "W_015",
              "#3": "D_004"
            }
          }
        }
      },
      "visible_topology": {
        "type": "object",
        "properties": {
          "grids": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "p1_mm",
                "p2_mm"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "example": "GR_A"
                },
                "label": {
                  "type": "string",
                  "example": "А"
                },
                "p1_mm": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "p2_mm": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          },
          "walls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "type_id",
                "start_mm",
                "end_mm",
                "thickness_mm",
                "height_mm",
                "is_pinned"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "example": "W_014"
                },
                "type_id": {
                  "type": "string",
                  "example": "WT_INT_120_BRICK"
                },
                "start_mm": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "example": [
                    0,
                    0
                  ]
                },
                "end_mm": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2,
                  "example": [
                    6000,
                    0
                  ]
                },
                "thickness_mm": {
                  "type": "number",
                  "example": 120
                },
                "height_mm": {
                  "type": "number",
                  "example": 3000
                },
                "is_pinned": {
                  "type": "boolean",
                  "example": false
                },
                "degree_start": {
                  "type": "integer",
                  "example": 2
                },
                "degree_end": {
                  "type": "integer",
                  "example": 3
                },
                "hosted_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "example": [
                    "D_004",
                    "WN_002"
                  ]
                }
              }
            }
          },
          "openings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "category",
                "host_wall_id",
                "type_id",
                "offset_from_start_mm",
                "width_mm",
                "height_mm"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "example": "D_004"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "Door",
                    "Window",
                    "WallOpening"
                  ]
                },
                "host_wall_id": {
                  "type": "string",
                  "example": "W_014"
                },
                "type_id": {
                  "type": "string",
                  "example": "DR_INT_800x2100"
                },
                "offset_from_start_mm": {
                  "type": "number",
                  "example": 1450
                },
                "width_mm": {
                  "type": "number",
                  "example": 800
                },
                "height_mm": {
                  "type": "number",
                  "example": 2100
                },
                "sill_height_mm": {
                  "type": "number",
                  "example": 0
                }
              }
            }
          },
          "rooms": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "number",
                "name",
                "area_m2"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "example": "RM_03"
                },
                "number": {
                  "type": "string",
                  "example": "103"
                },
                "name": {
                  "type": "string",
                  "example": "Коридор"
                },
                "zone_category": {
                  "type": "string",
                  "enum": [
                    "Living",
                    "Kitchen",
                    "WetZone",
                    "Corridor",
                    "Utility",
                    "Public",
                    "Undefined"
                  ],
                  "example": "Corridor"
                },
                "area_m2": {
                  "type": "number",
                  "example": 8.45
                },
                "perimeter_mm": {
                  "type": "number",
                  "example": 13400
                },
                "bounding_wall_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "diagnostics": {
        "type": "object",
        "description": "Актуальные предупреждения нормоконтроля (F088) и коллизий (F057).",
        "properties": {
          "norm_violations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rule_code": {
                  "type": "string",
                  "example": "СП 1.13130.2020 п.4.3.3"
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "Error",
                    "Warning"
                  ]
                },
                "element_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "example": [
                    "RM_03"
                  ]
                },
                "message": {
                  "type": "string",
                  "example": "Ширина эвакуационного коридора 1050 мм меньше требуемых 1200 мм"
                }
              }
            }
          },
          "clashes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "clash_id": {
                  "type": "string"
                },
                "element_a": {
                  "type": "string"
                },
                "element_b": {
                  "type": "string"
                },
                "intersection_volume_m3": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "integrity_report": {
        "type": "object",
        "description": "Необязательный структурированный результат проверки целостности ядром C++.",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "Valid",
              "Warnings",
              "Invalid",
              "NotChecked"
            ]
          },
          "checked_revision": {
            "type": "integer"
          },
          "violations_count": {
            "type": "integer",
            "minimum": 0
          },
          "warnings_count": {
            "type": "integer",
            "minimum": 0
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string"
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "Error",
                    "Warning",
                    "Info"
                  ]
                },
                "element_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "performance_metrics": {
        "type": "object",
        "description": "Необязательные измеренные показатели; не являются гарантией производительности.",
        "properties": {
          "serialization_time_us": {
            "type": "integer",
            "minimum": 0
          },
          "spatial_query_time_us": {
            "type": "integer",
            "minimum": 0
          },
          "visible_elements_count": {
            "type": "integer",
            "minimum": 0
          },
          "total_elements_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  "openai_tools": [
    {
      "type": "function",
      "function": {
        "name": "create_walls",
        "description": "Создает одну или цепочку параметрических стен (F022) с авто-стыковкой углов и Т-стыков (F103) в C++20 графе. Поддерживает $temp_id для ссылки из других команд батча.",
        "parameters": {
          "type": "object",
          "required": [
            "expected_revision",
            "segments",
            "wall_type_id"
          ],
          "properties": {
            "expected_revision": {
              "type": "integer",
              "minimum": 1
            },
            "wall_type_id": {
              "type": "string",
              "description": "ID типоразмера стены из project_meta.available_wall_types"
            },
            "level_id": {
              "type": "string",
              "description": "ID этажа (по умолчанию текущий активный этаж)"
            },
            "height_mm": {
              "type": "number",
              "minimum": 100,
              "description": "Высота стены в мм"
            },
            "location_line": {
              "type": "string",
              "enum": [
                "WallCenterline",
                "CoreCenterline",
                "FinishFaceExterior",
                "FinishFaceInterior"
              ],
              "default": "WallCenterline"
            },
            "segments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "start_mm",
                  "end_mm"
                ],
                "properties": {
                  "temp_id": {
                    "type": "string",
                    "pattern": "^\\$[a-zA-Z0-9_]+$",
                    "description": "Временный ID (например, '$w1') для врезки проёмов в эту стену в том же батче."
                  },
                  "start_mm": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "end_mm": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                }
              }
            },
            "request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
